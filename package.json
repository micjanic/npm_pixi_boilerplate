{
    "name": "@micjanic/create_pixi_project",
    "version": "1.0.5",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Michael Janicki",
        "url": "https://github.com/micjanic"
    },
    "bin": {
        "create-boilerplate": "./bin/generate-app.cjs"
    },
    "keywords": [],
    "files": [
        "dist",
        "src/components/images",
        "README.md"
    ],
    "main": "./dist/create_pixi_project.umd.js",
    "module": "./dist/create_pixi_project.es.js",
    "exports": {
        ".": {
            "import": "./dist/create_pixi_project.es.js",
            "require": "./dist/create_pixi_project.umd.js"
        }
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "release": "npm version patch && npm run build && git push --follow-tags && npm publish --access public",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview"
    },
    "dependencies": {
        "@pixi/react": "^8.0.3",
        "pixi.js": "^8.8.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@types/node": "^20.12.7",
        "@eslint/js": "^9.21.0",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-prettier": "^5.2.6",
        "pixi.js": "^8.12.0",
        "postcss": "^8.4.38",
        "prettier": "^3.5.3",
        "tailwindcss": "^3.4.3",
        "typescript": "~5.7.3",
        "@typescript-eslint/eslint-plugin": "^8.25.0",
        "@typescript-eslint/parser": "^8.25.0",
        "vite": "^6.2.0"
    },
    "eslintConfig": {
        "env": {
            "browser": true,
            "node": true,
            "es2020": true
        },
        "extends": [
            "eslint:recommended",
            "plugin:react/recommended"
        ],
        "parserOptions": {
            "sourceType": "module"
        }
    }
}
